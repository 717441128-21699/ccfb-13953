{
  "name": "film16-restore",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "16mm film scan restoration: optical soundtrack decode, picture repair, 24->25fps MCFI, browser MP4 encode",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "mp4-muxer": "^5.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
